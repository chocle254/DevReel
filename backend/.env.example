# ---- AI (any OpenAI-compatible endpoint; default is NVIDIA NIM / Nemotron) ----
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Verify the exact model id at build.nvidia.com before the first real run
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Long-running models may need several minutes per structured generation
LLM_TIMEOUT_SECONDS=300

# ---- URLs ----
# Public URL of THIS backend (used to build video/thumbnail links)
PUBLIC_API_URL=http://localhost:8000
# Public URL of the Vite frontend (Playwright opens {FRONTEND_URL}/render/...)
FRONTEND_URL=http://localhost:5173
# Comma separated browser origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173

# ---- Security ----
# Long random string. Signs the short-lived render tokens.
RENDER_SECRET=change-me-to-a-long-random-string
# Optional: raises the GitHub API rate limit (60/h unauthenticated)
GITHUB_TOKEN=

# ---- Storage ----
# On Railway, attach a volume at /data and set OUTPUT_DIR=/data/outputs
OUTPUT_DIR=./outputs

# ---- Pipeline ----
# playwright = real renderer, mock = placeholder clips (build the frontend/player first)
CAPTURE_MODE=playwright
# edge = free Edge neural voices (default), silent = no speech (dev only)
TTS_PROVIDER=edge
TTS_VOICE=en-US-AndrewNeural
# Subset of: problem,solution,flow,feature,technology,impact,closing
ENABLED_SCENE_TYPES=problem,flow,feature,closing
MAX_REPO_MB=150
